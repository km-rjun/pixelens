#!/bin/sh
# postrm — removal hook.
# We never enabled the unit on install, so we do not disable it here.
# Only reload the user manager so the removed unit stops being visible.
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
fi
exit 0
